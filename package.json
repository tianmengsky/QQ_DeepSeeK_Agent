{
  "name": "dsh-qq-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "QQ <-> DSH bridge: receive OneBot v11 events over HTTP and drive a DSH Agent session, then post the reply back to QQ.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./tool-scope": "./lib/agent/tool-scope.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "test": "node tools/run-tests.mjs"
  }
}
